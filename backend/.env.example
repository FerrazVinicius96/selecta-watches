# Connection string do PostgreSQL
# Exemplo local: postgresql://usuario:senha@localhost:5432/selecta_watches
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/selecta_watches

# Porta em que a API Express vai subir
PORT=3001

# Segredo usado para assinar o JWT do login de admin (troque em produção)
JWT_SECRET=troque-este-segredo-em-producao

# Tempo de expiração do token de admin
JWT_EXPIRES_IN=8h

# Origem permitida para CORS (URL do frontend em dev)
CORS_ORIGIN=http://localhost:5173

# Credenciais do admin padrão criado pelo script de seed (troque em produção)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=selecta2026
