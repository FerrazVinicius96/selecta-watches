# Em desenvolvimento, deixe VITE_API_URL vazio/comentado: o Vite faz proxy de
# /api para a API Express (ver vite.config.js), evitando qualquer questão de CORS.
# VITE_API_URL=http://localhost:3001/api

# Alvo do proxy de dev, caso a API não esteja na porta padrão 3001.
# VITE_API_PROXY_TARGET=http://localhost:3001
